{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devquitect.local/schemas/calibration-report.schema.json",
  "x-devquitect-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "run_id", "skill_snapshot_id", "skill_version", "model", "runtime", "suite_id", "suite_digest", "repetitions", "dimensions", "generated_at", "evidence_references"],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "behavior-calibration"},
    "run_id": {"type": "string", "minLength": 1},
    "skill_snapshot_id": {"type": "string", "minLength": 1},
    "skill_version": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "runtime": {"type": "object", "minProperties": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_digest": {"type": "string", "minLength": 1},
    "repetitions": {"type": "integer", "minimum": 1},
    "dimensions": {"type": "object"},
    "summary_score": {"type": "number"},
    "generated_at": {"type": "string", "format": "date-time"},
    "evidence_references": {"type": "array", "maxItems": 100}
  }
}
