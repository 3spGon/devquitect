{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devquitect.local/schemas/ci-evidence.schema.json",
  "x-devquitect-schema-version": 1,
  "title": "Devquitect CI package evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "workflow_path", "workflow_commit", "run_id", "run_attempt", "event", "ref", "source_commit", "snapshot_id", "version", "pr", "toolchain", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "workflow_path": {"const": ".github/workflows/ci.yml"},
    "workflow_commit": {"$ref": "#/$defs/commit"},
    "run_id": {"type": "integer", "minimum": 1},
    "run_attempt": {"type": "integer", "minimum": 1},
    "event": {"enum": ["push", "pull_request"]},
    "ref": {"type": "string", "pattern": "^refs/(heads/main|pull/[1-9][0-9]*/merge)$"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "pr": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
          "required": ["integration_commit", "head_commit", "base_commit"],
          "properties": {
            "integration_commit": {"$ref": "#/$defs/commit"},
            "head_commit": {"$ref": "#/$defs/commit"},
            "base_commit": {"$ref": "#/$defs/commit"}
          }
        }
      ]
    },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["python", "uv", "quality_version", "quality_source_commit", "compression_runtime", "runner_image", "lock_sha256"],
      "properties": {
        "python": {"type": "string", "pattern": "^3\\.12\\.[0-9]+$"},
        "uv": {"type": "string", "minLength": 1},
        "quality_version": {"type": "string", "minLength": 1},
        "quality_source_commit": {"$ref": "#/$defs/commit"},
        "compression_runtime": {"type": "string", "minLength": 1},
        "runner_image": {"type": "string", "minLength": 1},
        "lock_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "files": {
      "type": "object", "additionalProperties": false,
      "required": ["zip", "manifest", "report"],
      "properties": {
        "zip": {"$ref": "#/$defs/file"},
        "manifest": {"$ref": "#/$defs/file"},
        "report": {"$ref": "#/$defs/file"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"event": {"const": "push"}}},
      "then": {"properties": {"pr": {"type": "null"}, "ref": {"const": "refs/heads/main"}}},
      "else": {"properties": {"pr": {"type": "object"}, "ref": {"pattern": "^refs/pull/[1-9][0-9]*/merge$"}}}
    }
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_-][A-Za-z0-9_./-]*$"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
